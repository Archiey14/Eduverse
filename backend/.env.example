# Backend port. The frontend defaults to http://localhost:5001/api, so keep 5001
# (or set VITE_API_URL in frontend/.env to match).
PORT=5001
NODE_ENV=development

# Local MongoDB. For Atlas use your own mongodb+srv:// string (never commit it).
MONGO_URI=mongodb://localhost:27017/eduverse

# Use a long random string, e.g.  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# Optional: seed scripts
# SEED_PASSWORD=choose-a-demo-password      # used by npm run seed:demo
# ADMIN_PASSWORD=choose-an-admin-password   # used by npm run seed:admin (random if unset)
